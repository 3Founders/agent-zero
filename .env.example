# Agent 0 — environment variables
# Copy this file to `.env` for local dev, or set each of these as real
# environment variables in the Vercel project (Project Settings → Environment
# Variables). See docs/setup-secrets-guide.md for how to obtain each value.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# ── Database (Supabase Postgres) ────────────────────────────────────────────
# Use the "Transaction pooler" connection string from Supabase project
# Settings → Database → Connection string (port 6543, pgbouncer mode) —
# required for serverless since each invocation opens a fresh connection.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=no-verify

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Google Sheets / Drive ────────────────────────────────────────────────────
# Base64-encoded service-account JSON key (see docs/setup-secrets-guide.md)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# ── Dashboard auth ────────────────────────────────────────────────────────────
ADMIN_PASSWORD=

# ── LLM extraction (OpenAI-compatible) ──────────────────────────────────────
# On Replit, AI_INTEGRATIONS_OPENAI_* are auto-provisioned and free — leave
# unset there. Off-platform (Vercel), set OPENAI_API_KEY + OPENAI_BASE_URL
# (or point at any OpenAI-compatible provider, e.g. Sarvam):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EXTRACTION_MODEL=gpt-4o-mini
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# ── Reminder scheduler (optional, defaults shown) ───────────────────────────
TRIAL_TIMEZONE=Asia/Kolkata
REMINDER_MORNING_TIME=08:00
REMINDER_EVENING_TIME=20:00

# ── Vercel Cron auth (recommended once deployed) ────────────────────────────
# Set this in Vercel; Vercel Cron automatically sends it as
# `Authorization: Bearer $CRON_SECRET` when hitting /api/cron/tick.
CRON_SECRET=
